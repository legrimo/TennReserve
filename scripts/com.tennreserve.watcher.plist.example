<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tennreserve.watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/.tools/node/bin/node</string>
        <string>__REPO_ROOT__/node_modules/tsx/dist/cli.mjs</string>
        <string>__REPO_ROOT__/src/index.ts</string>
        <string>watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/storage/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/storage/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__REPO_ROOT__/.tools/node/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
