[Unit]
Description=TennReserve McCarren Park watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tennreserve
Group=tennreserve
WorkingDirectory=/opt/TennReserve
Environment=TZ=America/New_York
Environment=NODE_ENV=production
# Prefer system Node; adjust path if you installed via nvm/fnm.
ExecStart=/usr/bin/node /opt/TennReserve/node_modules/tsx/dist/cli.mjs /opt/TennReserve/src/index.ts watch --headless
Restart=always
RestartSec=5
# Firefox/Chromium can use a fair amount of RAM during booking bursts.
MemoryMax=1500M

# Hardening (keep writable storage/ for attempts, ledger, profile, logs)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
