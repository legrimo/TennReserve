# Copy to .env and fill in. NEVER commit .env.
# Billing data must exactly match the virtual card's registered address (Payflow checks AVS).

# Virtual card (use a capped, single-merchant card — e.g. Privacy.com)
CARD_NUMBER=
CARD_EXP_MONTH=06
CARD_EXP_YEAR=31
CARD_CVV=

# Identity (name must match photo ID shown at the court)
FIRST_NAME=
LAST_NAME=
EMAIL=
PHONE=

# Billing address on the card
BILLING_ADDRESS=
BILLING_APT=
BILLING_CITY=
BILLING_STATE=NY
BILLING_ZIP=

# Permits — how many in the party have a season/single-play permit on file.
# Default 2 (both players) keeps the total at $15 court fee only.
PARTY_PERMITS=2
# PERMIT_NUMBER=       # optional — only if the form shows permit number fields
# PLAYER2_NAME=
# PLAYER2_PERMIT=

# Dashboard (optional)
# PORT=3001
# DASHBOARD_TOKEN=     # require Bearer token on /api routes if set

# Notifications (optional — macOS alerts always fire on this machine)
# iMessage: uses IMESSAGE_TO if set, otherwise falls back to PHONE above
# IMESSAGE_TO=+15551234567
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_ON_FAILURE=true

# Booker host: one US-NY mobile HTTP proxy for NYC Parks (CloudFront WAF).
# Parks availability + checkout stay on this proxy. Hosted Payflow/PayPal bypass
# it (direct egress) — MobileProxyNow often 403s payflowlink.paypal.com.
# Do not add a second payment proxy. Never commit this file.
# PROXY_HTTP=http://USER:PASS@host:port
# Routing only (no paid proxy): npm run probe-proxy-split
# TENNRESERVE_BROWSER=firefox
# Optional override (comma-separated). Playwright/Firefox format: leading-dot
# suffix (".paypal.com"), not Chromium "*.paypal.com". Do not list nycgovparks.org
# — payment-endpoint/success must stay on the Parks proxy path.
# PROXY_BYPASS=payflowlink.paypal.com,pilot-payflowlink.paypal.com,.paypal.com,.paypalobjects.com
