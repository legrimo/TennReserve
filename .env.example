# Copy to .env and fill in. NEVER commit .env.
# Billing data must exactly match the virtual card's registered address (Payflow checks AVS).

# Virtual card (use a capped, single-merchant card — e.g. Privacy.com)
CARD_NUMBER=
CARD_EXP_MONTH=06
CARD_EXP_YEAR=31
CARD_CVV=

# Identity (name must match photo ID shown at the court)
FIRST_NAME=
LAST_NAME=
EMAIL=
PHONE=

# Billing address on the card
BILLING_ADDRESS=
BILLING_APT=
BILLING_CITY=
BILLING_STATE=NY
BILLING_ZIP=

# Permits — how many in the party have a season/single-play permit on file.
# Default 2 (both players) keeps the total at $15 court fee only.
PARTY_PERMITS=2
# PERMIT_NUMBER=       # optional — only if the form shows permit number fields
# PLAYER2_NAME=
# PLAYER2_PERMIT=
