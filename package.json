{
  "name": "tennreserve",
  "version": "0.1.0",
  "description": "McCarren Park tennis court auto-booker (facility 11)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsx src/index.ts watch",
    "discover": "tsx src/index.ts discover",
    "book": "tsx src/index.ts book",
    "dry-run": "tsx src/index.ts book --dry-run",
    "test:parser": "tsx src/parser.test.ts",
    "server": "tsx src/server/index.ts",
    "ui": "npm run dev --prefix web",
    "dev": "concurrently -n api,ui -c blue,green \"npm run server\" \"npm run ui\"",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "playwright": "^1.49.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
